PROJECT_NAME           = "Carbon Blue compatibility surface"
OUTPUT_DIRECTORY       = target/doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
INPUT                  = include src tests blueexposure
FILE_PATTERNS          = *.h *.hpp *.cpp *.cc *.c *.py
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */vendor/* */.git/* */__pycache__/*
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
CASE_SENSE_NAMES       = YES
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SKIP_FUNCTION_MACROS   = NO
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = YES
PYTHON_DOCSTRING       = YES
