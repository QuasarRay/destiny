@PACKAGE_INIT@

set_and_check(_DBC_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")

if(WIN32)
    set_and_check(_DBC_RUNTIME "@PACKAGE_CMAKE_INSTALL_BINDIR@/destiny_bevy_compat.dll")
    set_and_check(_DBC_IMPLIB "@PACKAGE_CMAKE_INSTALL_LIBDIR@/destiny_bevy_compat.dll.lib")
elseif(APPLE)
    set_and_check(_DBC_RUNTIME "@PACKAGE_CMAKE_INSTALL_LIBDIR@/libdestiny_bevy_compat.dylib")
else()
    set_and_check(_DBC_RUNTIME "@PACKAGE_CMAKE_INSTALL_LIBDIR@/libdestiny_bevy_compat.so")
endif()

if(NOT TARGET destiny::bevy_compat)
    add_library(destiny::bevy_compat SHARED IMPORTED)
    set_target_properties(destiny::bevy_compat PROPERTIES
        IMPORTED_LOCATION "${_DBC_RUNTIME}"
        INTERFACE_INCLUDE_DIRECTORIES "${_DBC_INCLUDE_DIR}"
    )
    if(WIN32)
        set_target_properties(destiny::bevy_compat PROPERTIES IMPORTED_IMPLIB "${_DBC_IMPLIB}")
    endif()
endif()

foreach(_DBC_ALIAS IN ITEMS Destiny destiny carbon-destiny::destiny)
    if(NOT TARGET ${_DBC_ALIAS})
        add_library(${_DBC_ALIAS} INTERFACE IMPORTED)
        set_target_properties(${_DBC_ALIAS} PROPERTIES INTERFACE_LINK_LIBRARIES destiny::bevy_compat)
    endif()
endforeach()

set(carbon-destiny_FOUND TRUE)
set(Destiny_FOUND TRUE)
set(destiny_FOUND TRUE)
