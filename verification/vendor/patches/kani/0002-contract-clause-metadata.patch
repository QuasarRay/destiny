+//!                     kani::internal::apply_closure(
+//!                         |result| (remember_kani_internal_2e780b148d45b5c8) == *ptr,
+//!                         &result_kani_internal,
+//!                     ),
+//!                     stringify!(|result| old(*ptr + 1) == *ptr),
+//!                 );
