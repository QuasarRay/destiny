+/// Generate only compiler metadata for a Cargo project.
+///
+/// This deliberately stops before `Project::try_new`, which links GOTO artifacts.
+/// It is used by metadata/list consumers that need Kani's compiler discovery and
+/// autoharness generation but do not need a verification backend.
+pub fn cargo_metadata_only(
+    session: &mut KaniSession,
+    keep_going: bool,
+) -> Result<Vec<KaniMetadata>> {
+    let outputs = session.cargo_build(keep_going)?;
+    outputs
+        .metadata
+        .iter()
+        .map(|md_file| from_json(md_file))
+        .collect::<Result<Vec<_>>>()
+}
