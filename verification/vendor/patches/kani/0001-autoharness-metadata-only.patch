+    #[strum(serialize = "Requires --bounded-arguments for argument(s)")]
+    RequiresBoundedArguments(Vec<(String, String)>),
+    /// The function doesn't match the user's provided filters.
+    #[strum(serialize = "Did not match provided filters")]
+    UserFilter,
