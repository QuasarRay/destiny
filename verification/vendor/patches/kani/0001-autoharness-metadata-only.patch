-            self.tcx
-                .dcx()
-                .struct_span_err(
-                    attr.span(),
-                    format!(
-                        "Failed to check contract: `{}` has no contract.",
-                        target_attributes.item_name(),
-                    ),
-                )
-                .with_span_note(
-                    rustc_internal::internal(self.tcx, target_def.span()),
