# Settings adapted from Trinity's Doxyfile.in; Destiny inputs only.
# Provenance and extraction limits: reuse.json. Not a compiler configuration.
PROJECT_NAME = "Original Destiny"
OUTPUT_DIRECTORY = $(DESTINY_DOC_OUTPUT)
INPUT = $(DESTINY_ORIGINAL_ROOT)/include $(DESTINY_ORIGINAL_ROOT)/src $(DESTINY_ORIGINAL_ROOT)/python $(DESTINY_ORIGINAL_ROOT)/tests
FILE_PATTERNS = *.h *.hpp *.cpp *.c *.py
RECURSIVE = YES
EXTRACT_ALL = YES
EXTRACT_PRIVATE = YES
EXTRACT_PRIV_VIRTUAL = YES
EXTRACT_STATIC = YES
EXTRACT_LOCAL_CLASSES = YES
EXTRACT_LOCAL_METHODS = YES
EXTRACT_ANON_NSPACES = YES
HIDE_UNDOC_MEMBERS = NO
HIDE_UNDOC_CLASSES = NO
GENERATE_HTML = NO
GENERATE_LATEX = NO
GENERATE_XML = YES
XML_PROGRAMLISTING = YES
XML_NS_MEMB_FILE_SCOPE = YES
ENABLE_PREPROCESSING = YES
MACRO_EXPANSION = NO
SKIP_FUNCTION_MACROS = NO
PREDEFINED =
INCLUDE_PATH = $(DESTINY_ORIGINAL_ROOT)/include $(DESTINY_ORIGINAL_ROOT)/src
EXCLUDE =
EXCLUDE_PATTERNS =
EXCLUDE_SYMBOLS =
QUIET = YES
WARN_LOGFILE = $(DESTINY_DOC_OUTPUT)/warnings.log
